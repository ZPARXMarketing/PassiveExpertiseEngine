# Copy to .env.local for local dev (Vite reads VITE_* at build time).
# Both are optional: leave them unset and the app stores everything in this browser's localStorage.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# Server-side (Netlify site environment variables, or `netlify env:set`):
# OPENROUTER_API_KEY=sk-or-...        required for generation (or paste a key in Settings)
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_FACTCHECK_MODEL=perplexity/sonar
# OPENROUTER_PATH_MODEL=google/gemini-3.8-flash
# OPENROUTER_TTS_MODEL=microsoft/mai-voice-2.1-flash
# APP_PASSWORD=...                    optional; unset = site is open
